---
import Layout from '../layouts/Layout.astro';
import { initSubmitForm } from '../scripts/submitForm';
---

<Layout>
  <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-6">
    <p class="text-gray-700 mb-6">Submit a movie for the blind watch contest. Provide the movie title, director, and optionally your name.</p>

    <form id="submit-form" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Movie Title</label>
        <input id="movie-title" name="title" type="text" required class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Director</label>
        <input id="movie-director" name="director" type="text" required class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Submitted by</label>
        <input id="submitted-by" name="submitted_by" type="text" placeholder="Optional" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" />
      </div>

      <button id="submit-button" type="submit" class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">Submit Movie</button>
    </form>

    <div id="submit-message" class="mt-6 rounded-xl p-4 hidden"></div>
  </div>

  <script>
    import { initSubmitForm } from '../scripts/submitForm';
    initSubmitForm();
  </script>
</Layout>
